{
  "expo": {
    "name": "ECT Technician",
    "slug": "truck-driver-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/log.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/log.png",
      "resizeMode": "contain",
      "backgroundColor": "#1677ff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.internal.truckdriver",
      "infoPlist": {
        "NSCameraUsageDescription": "The camera is used to take photos of the finished job as proof of work.",
        "NSPhotoLibraryUsageDescription": "Photos from your library can be attached to a finished job as proof of work.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "fetch"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/log.png",
        "backgroundColor": "#1677ff"
      },
      "package": "com.internal.truckdriver",
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "The camera is used to take photos of the finished job as proof of work.",
          "photosPermission": "Photos from your library can be attached to a finished job as proof of work.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "truckdriver",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0da4519f-0ea6-48d5-861f-9131921cb4af"
      }
    },
    "owner": "qianyong000"
  }
}

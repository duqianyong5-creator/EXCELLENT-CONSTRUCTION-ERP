# ==================================================
# Supabase 配置（推荐）
# 从 Supabase Dashboard → Settings → Database 获取
# ==================================================

# 连接串格式（Session Mode / Transaction Mode 二选一）
# Session Mode (port 5432) - 适合低并发/开发
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Transaction Mode (port 6543) - 适合高并发/生产
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase 项目信息（用于 Storage 文件上传）
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=truck-uploads

# ==================================================
# JWT（自行生成强密钥）
# 生成命令：node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ==================================================
JWT_SECRET=your-256bit-secret-key-change-this
JWT_EXPIRES_IN=7d

# ==================================================
# 应用
# ==================================================
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ==================================================
# Google Maps（后端可选，主要前端使用）
# ==================================================
GOOGLE_MAPS_API_KEY=AIzaSy...
